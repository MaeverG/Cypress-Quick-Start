{
  "name": "cypress-quick-start",
  "version": "1.0.0",
  "description": "Boilerplate Cypress API + UI test framework — copy this repo to start a new service's test suite.",
  "scripts": {
    "cy:open:local": "npx cypress open --env environmentName=local --e2e --browser chrome",
    "cy:open:dev": "npx cypress open --env environmentName=dev --e2e --browser chrome",
    "cy:open:staging": "npx cypress open --env environmentName=staging --e2e --browser chrome",
    "cy:run:chrome:local": "npx cypress run --env \"environmentName=local,grepTags=${npm_config_greptags:-$npm_config_grepTags},grep=$npm_config_grep\" --browser=chrome ${npm_config_spec:+--spec=$npm_config_spec}",
    "cy:run:chrome:dev": "npx cypress run --env \"environmentName=dev,grepTags=${npm_config_greptags:-$npm_config_grepTags},grep=$npm_config_grep\" --browser=chrome ${npm_config_spec:+--spec=$npm_config_spec}",
    "cy:run:firefox:local": "npx cypress run --env \"environmentName=local,grepTags=${npm_config_greptags:-$npm_config_grepTags},grep=$npm_config_grep\" --browser=firefox ${npm_config_spec:+--spec=$npm_config_spec}",
    "cy:run:ci": "npx cypress run --env environmentName=ci --browser=chrome",
    "cy:report": "open cypress/reports/html/index.html",
    "lint": "eslint cypress --ext .ts",
    "lint:fix": "eslint cypress --ext .ts --fix",
    "prepare": "husky install"
  },
  "lint-staged": {
    "cypress/**/*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.2",
    "cy-spok": "^1.6.2",
    "cypress-multi-reporters": "^1.6.4",
    "cypress-plugin-steps": "^1.1.1",
    "dayjs": "^1.11.12",
    "mocha-junit-reporter": "^2.2.1",
    "mochawesome-merge": "^5.0.0",
    "mochawesome-report-generator": "^6.2.0",
    "pg": "^8.12.0",
    "ssh2": "^1.15.0",
    "typescript": "5.5.4"
  },
  "devDependencies": {
    "@cypress/grep": "^3.1.5",
    "@types/chance": "^1.1.6",
    "@types/node": "^22.0.2",
    "@types/pg": "^8.16.0",
    "@types/ssh2": "^1.15.5",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "chance": "^1.1.12",
    "cypress": "^15.9.0",
    "cypress-get-by-label": "^2.5.0",
    "cypress-mochawesome-reporter": "^3.8.2",
    "cypress-plugin-api": "^2.11.2",
    "cypress-recurse": "^1.37.1",
    "cypress-terminal-report": "^6.1.2",
    "cypress-xpath": "^2.0.1",
    "dotenv": "^16.4.5",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-cypress": "^2.12.1",
    "eslint-plugin-prettier": "^5.0.0",
    "husky": "^9.1.4",
    "lint-staged": "^15.2.7",
    "prettier": "^3.0.0"
  }
}
